          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save TRIP_ID globally" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def manual = vars.get(&quot;TEST_TRIP_ID&quot;)?.trim()
if (manual) {
  props.put(&quot;HIKORA_TRIP_ID&quot;, manual)
} else {
  def id = vars.get(&quot;TRIP_ID&quot;)
  if (id != null &amp;&amp; !id.isEmpty()) {
    props.put(&quot;HIKORA_TRIP_ID&quot;, id)
  }
}</stringProp>
