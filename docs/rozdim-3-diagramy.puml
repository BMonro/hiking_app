@startuml fig_3_7_activity_create_route
title Рис. 3.7 — Діаграма діяльності: створення маршруту (UML Activity Diagram)

skinparam shadowing false
skinparam activity {
  BackgroundColor white
  BorderColor black
  FontSize 11
}
skinparam arrowColor black

|Користувач|
start
:Вкладка «Маршрути»\n(RoutesScreen);
:Натиснути «Додати»;

|Система|
:Відкрити RouteEditorScreen\n(форма «Новий маршрут»);

|Користувач|
:Заповнити назву, опис,\nскладність, тип маршруту;

partition "Введення точок маршруту" {
  repeat
    |Користувач|
    :Редагувати точку\n(старт / фініш / проміжна);
    :Ввести назву або lat/lon;

    |Система|
    if (Запит пошуку\n≥ 3 символи?) then (так)
      fork
        :Каталог route_points\n(Supabase, ilike);
      fork again
        :geosearch / Nominatim\n(OsmNominatimService);
      end fork
      :Об'єднати підказки;
      :Опційно: вершини OSM\n(searchForRoutePeaks);
    else (ні)
    endif

    |Користувач|
    if (Обрано підказку?) then (так)
      :Підставити координати\nі висоту в поля;
    else (вручну)
    endif

    |Система|
    :Локальний preview метрик\n(відстань, набір, час)\nHaversine + евристика;
  repeat while (Ще точки\nабо зміни?) is (так) not (ні)
}

|Користувач|
:Натиснути «Зберегти»;

|Система|
if (Валідація форми\n+ старт і фініш\nз координатами?) then (ні)
  :SnackBar(помилка);
  stop
else (так)
endif

:SaveRouteApi.createRoute\n→ Edge Function save-route;

if (Відповідь save-route\nуспішна?) then (так)
  |Система|
  :route-hike → geojson;\nINSERT routes + route_points;
  :invalidate(routesProvider);
  |Користувач|
  :Повернення до каталогу;
else (помилка Edge)
  |Система|
  :Fallback: RoutesRepository\n(PostgREST routes +\nreplaceRoutePoints);
  |Користувач|
  :Повернення до каталогу;
endif

stop

@enduml


' -----------------------------------------------------------------------------


@startuml fig_3_8_sequence_create_route
title Рис. 3.8 — Діаграма послідовності: створення маршруту (UML Sequence Diagram)

autonumber
skinparam responseMessageBelowArrow true

actor ":Користувач:" as User
boundary ":RoutesScreen\nRouteEditor:" as UI
control ":RoutesRepository:" as Repo
control ":OsmNominatimService:" as Geo
control ":Edge Function\ngeosearch:" as EFGeo
control ":SaveRouteApi:" as SaveApi
control ":Edge Function\nsave-route:" as EFSave
entity ":PostgreSQL\n(Supabase):" as DB

== Введення точок ==

User -> UI : openCreateRouteDialog()
activate UI

loop Для кожної точки (старт, фініш, проміжні)
  User -> UI : ввести назву / обрати з пошуку
  UI -> Geo : search / searchRoutePlaces(query)
  activate Geo
  Geo -> EFGeo : invoke({action: route_places})
  activate EFGeo
  EFGeo --> Geo : results
  deactivate EFGeo
  Geo --> UI : suggestions
  deactivate Geo
  User -> UI : обрати місце
  UI -> UI : preview metrics (локально)
end

== Збереження ==

User -> UI : save()
UI -> UI : validate(title, start, finish)

alt [дані некоректні]
  UI --> User : SnackBar(помилки)
else [дані коректні]
  UI -> SaveApi : createRoute / updateRoute
  activate SaveApi
  SaveApi -> EFSave : invoke({action, points, …})
  activate EFSave
  EFSave -> EFSave : computeRouteStats +\nroute-hike → geojson
  EFSave -> DB : INSERT/UPDATE routes\n+ route_points
  DB --> EFSave : route_id
  EFSave --> SaveApi : ok
  deactivate EFSave
  SaveApi --> UI : route_id
  deactivate SaveApi
  UI -> UI : invalidate(routesProvider)
  UI --> User : close dialog, оновити каталог
end

deactivate UI

@enduml


' -----------------------------------------------------------------------------


@startuml fig_3_9_sequence_group_trips
title Рис. 3.9 — Діаграма послідовності: групові походи\n(створення, заявка, рішення організатора) (UML Sequence Diagram)

autonumber
skinparam responseMessageBelowArrow true

actor ":Організатор:" as Org
actor ":Учасник:" as Member
boundary ":GroupHikesScreen:" as UI
control ":TripsApi:" as Api
control ":Edge Function\ntrip-actions:" as EF
entity ":PostgreSQL\n(Supabase):" as DB
control ":Realtime\n(sync):" as RT

== 1. Створення групового походу (організатор) ==

Org -> UI : createTrip()
activate UI

UI -> DB : SELECT routes\n(is_public, with route_points)
activate DB
DB --> UI : list<Route>
deactivate DB

Org -> UI : заповнити форму\n(маршрут, назва, опис,\nмісце збору, дати, max_members)
UI -> UI : validate()

alt [помилки валідації]
  UI --> Org : AlertDialog(список помилок)
else [дані коректні]
  UI -> Api : createTrip(…)
  activate Api
  Api -> EF : invoke({action: create, …})
  activate EF
  EF -> DB : INSERT INTO trips\n(trip_code на сервері)
  DB --> DB : <<trigger>>\ntrip_organizer_participant
  EF --> Api : {trip_id, trip_code}
  deactivate EF
  Api --> UI : success
  deactivate Api
  UI -> UI : invalidate(groupHikesProvider)
  UI --> Org : SnackBar / закрити форму
end

deactivate UI

== 2. Подача заявки на участь (учасник) ==

Member -> UI : joinTrip(tripId)
activate UI
UI -> UI : перевірка max_members (клієнт)

UI -> Api : applyToTrip(tripId)
activate Api
Api -> EF : invoke({action: apply, trip_id})
activate EF

EF -> DB : SELECT trips (status, organizer)
EF -> DB : SELECT trip_participants\n(дубль / already_member)
EF -> DB : COUNT approved < max_members?

alt [група повна / не open / організатор]
  EF --> Api : error (trip_full, …)
  Api --> UI : TripsApiException
  UI --> Member : SnackBar(помилка)
else [заявка дозволена]
  EF -> DB : UPSERT trip_participants\nstatus = pending
  EF -> DB : INSERT notifications\n→ organizer (trip_request)
  EF --> Api : {ok, status: pending}
  deactivate EF
  Api --> UI : success
  deactivate Api
  UI --> Member : SnackBar(«Запит надіслано»)
  RT --> UI : postgres_change\n(invalidate list)
end

deactivate UI

== 3. Рішення організатора (схвалення / відхилення) ==

Org -> UI : manageRequests(tripId)
activate UI
UI -> DB : SELECT trip_participants\nWHERE status = pending
activate DB
DB --> UI : applicants + profiles
deactivate DB
UI --> Org : bottom sheet (список заявок)

Org -> UI : approve / reject(applicantId)
UI -> Api : decideParticipant(\ntripId, applicantId, approved)
activate Api
Api -> EF : invoke({action: decide, …})
activate EF

EF -> DB : перевірка organizer_id
alt [approved]
  EF -> DB : перевірка ліміту місць
end
EF -> DB : UPDATE trip_participants\nstatus = approved | rejected
EF -> DB : INSERT notifications\n→ applicant (trip_approved | trip_rejected)
EF --> Api : {ok, status}
deactivate EF
Api --> UI : success
deactivate Api

UI --> Org : SnackBar, закрити sheet
RT --> UI : invalidate providers

deactivate UI

@enduml


