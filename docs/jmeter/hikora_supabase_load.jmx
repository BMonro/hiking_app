          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save JWT globally" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def t = vars.get(&quot;JWT&quot;)
if (t != null &amp;&amp; t != &quot;JWT_MISSING&quot; &amp;&amp; !t.isEmpty()) {
  props.put(&quot;HIKORA_JWT&quot;, t)
}</stringProp>
          </JSR223PostProcessor>
