@startuml fig_3_2_component_server
title Рис. 3.2а — Діаграма компонентів серверної частини (UML 2 Component Diagram)

skinparam packageStyle rectangle

package "Хмарна платформа Supabase" as supabase {

  package "Сервіси доступу\n<<service>>" as api_layer {
    component [PostgREST API] as postgrest
    component [Auth Service\nemail + Google OAuth] as auth_svc
    component [Realtime\nWebSocket] as realtime
    component [Object Storage\nbucket: avatars] as storage
    interface "IREST" as IREST
    interface "IAuthJWT" as IAuthJWT
    interface "IRealtime" as IRT
    interface "IStorage" as IST
    postgrest ..|> IREST
    auth_svc ..|> IAuthJWT
    realtime ..|> IRT
    storage ..|> IST
  }

  package "Edge Functions\n<<service>> Deno" as edge {
    component [ai-chat] as fn_chat
    component [recommend-routes] as fn_rec
    component [trip-actions] as fn_trip
    component [trip-chat] as fn_tchat
    component [route-hike] as fn_route
    component [weather] as fn_weather
    component [geosearch] as fn_geo
    component [poi-nearby] as fn_poi
    component [save-route] as fn_save
    component [prepare-offline-route] as fn_prep
    component [_shared\nauth, routing, geosearch,\nweather_api, poi, cors] as fn_shared
    interface "IEdgeFn" as IEdge
    fn_chat ..|> IEdge
    fn_rec ..|> IEdge
    fn_trip ..|> IEdge
    fn_tchat ..|> IEdge
    fn_route ..|> IEdge
    fn_weather ..|> IEdge
    fn_geo ..|> IEdge
    fn_poi ..|> IEdge
    fn_save ..|> IEdge
    fn_prep ..|> IEdge
    fn_chat --> fn_shared
    fn_rec --> fn_shared
    fn_trip --> fn_shared
    fn_tchat --> fn_shared
    fn_route --> fn_shared
    fn_weather --> fn_shared
    fn_geo --> fn_shared
    fn_poi --> fn_shared
    fn_save --> fn_shared
    fn_prep --> fn_shared
  }

  database "PostgreSQL\n15 таблиць + RLS" as pg {

    package "Користувачі" as db_user {
      component [profiles] as t_profiles
      component [profile_health_conditions] as t_health
    }

    package "Маршрути" as db_routes {
      component [routes] as t_routes
      component [route_points] as t_points
      component [route_ratings] as t_ratings
      component [saved_routes] as t_saved
      component [offline_routes] as t_offline
    }

    package "Походи" as db_trips {
      component [trips] as t_trips
      component [trip_participants] as t_part
      component [messages] as t_messages
    }

    package "Журнал і досягнення" as db_journal {
      component [journal_entries] as t_journal
      component [journal_photos] as t_photos
      component [achievements] as t_ach
      component [user_achievements] as t_uach
    }

    package "Сповіщення" as db_notif {
      component [notifications] as t_notif
    }

    component [profile_stats\n<<view>>] as v_stats
  }
}

component "OpenAI API\ngpt-4o-mini" as openai #FFFFFF
component "OpenWeatherMap" as owm_ext #FFFFFF
component "GraphHopper / OSRM" as route_ext #FFFFFF
component "Nominatim / Overpass" as geo_ext #FFFFFF

' --- Зв’язки сервісів з БД ---
postgrest --> pg : <<SQL>>\nCRUD
auth_svc --> pg : <<SQL>>\nusers / profiles
realtime --> pg : <<WAL>>\nпідписки
storage --> pg : <<metadata>>
fn_chat --> pg : <<SQL>>
fn_rec --> pg : <<SQL>>
fn_trip --> pg : <<SQL>>
fn_tchat --> pg : <<SQL>>
fn_save --> pg : <<SQL>>
fn_prep --> pg : <<SQL>>

fn_chat -0)- openai : <<HTTPS>>
fn_rec -0)- openai : <<HTTPS>>
fn_weather -0)- owm_ext : <<HTTPS>>
fn_route -0)- route_ext : <<HTTPS>>
fn_geo -0)- geo_ext : <<HTTPS>>
fn_poi -0)- geo_ext : <<HTTPS>>
fn_prep -0)- route_ext : <<HTTPS>>

note right of edge
  **trip-actions:** create, update, apply,\ndecide, cancel, close, leave
  **trip-chat:** list, send + new_message
  **route-hike / save-route / prepare-offline-route**
  **weather / geosearch / poi-nearby**
  **ai-chat / recommend-routes**
  JWT: _shared/auth; секрети в Supabase
end note

note bottom of pg
  Row Level Security (RLS):
  доступ лише до власних даних
  або публічних маршрутів / походів
end note

@enduml


