@startuml fig_3_2_component_layers
title Рис. 3.2 — Діаграма компонентів клієнта (UML 2 Component Diagram)

package "Клієнтська програма Hikora" {

  package "Шар представлення\n<<layer>>" as L_pres {
    component [UI Screens\nWidgets] as ui
    component [State Management\nRiverpod] as state
    component [Navigation\ngo_router] as router
    router -0)- ui
    state -0)- ui
  }

  package "Шар застосунку\n<<layer>>" as L_app {
    component [Use Cases /\nProviders] as usecases
  }

  package "Доменний шар\n<<layer>>" as L_dom {
    component [Domain Models] as models
  }

  package "Інфраструктурний шар\n<<layer>>" as L_infra {
    component [Repositories] as repos
    component [External Services] as services
    component [Supabase Client] as supa
    component [HTTP Client\nDio] as dio
    component [Local File I/O] as files
  }

  interface "IRepository" as IRepo
  interface "IRoutingService" as IRouting
  interface "IOfflineMapStore" as IOffline
  interface "IGeoSearch" as IGeo

  state ..> usecases : <<use>>
  usecases ..> models : <<use>>
  usecases ..> IRepo
  usecases ..> IRouting
  usecases ..> IOffline
  usecases ..> IGeo

  repos ..|> IRepo
  services ..|> IRouting
  services ..|> IGeo
  files ..|> IOffline

  repos --> supa
  services --> dio
}

package "Модулі функцій\n<<subsystem>>" as mods #FFFFFF {
  component [auth] as m_auth
  component [routes] as m_routes
  component [navigation] as m_nav
  component [weather] as m_weather
  component [trips] as m_trips
  component [journal] as m_journal
  component [profile] as m_profile
  component [ai] as m_ai
  component [home] as m_home
}

ui ..> mods : <<access>>
repos ..> mods
services ..> mods

@enduml


' -----------------------------------------------------------------------------


